#include <stdio.h>

#define MAX 5

int queue[MAX];
int front = 0;
int rear = 0;

void enqueue(int x)
{
    if(rear == MAX)
    {
        printf("Overflow");
        return;
    }

    queue[rear++] = x;
    printf("Value is %d", queue[rear-1]);
}

int main()
{
    int x;

    printf("Enter the value: ");
    scanf("%d",&x);

    enqueue(x);

    return 0;
}
