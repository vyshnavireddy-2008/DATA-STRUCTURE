#include <stdio.h>

#define SIZE 5

int queue[SIZE];
int front = -1;
int rear = -1;

void enqueue(int item)
{
    if(rear == SIZE - 1)
    {
        printf("Queue Full\n");
        return;
    }

    if(front == -1)
        front = 0;

    rear++;
    queue[rear] = item;
}

int main()
{
    enqueue(10);
    enqueue(20);
    enqueue(30);

    for(int i = front; i <= rear; i++)
    {
        printf("%d ", queue[i]);
    }

    return 0;
}
